# SkillSwap environment variables.
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env` — it is
# gitignored. The values here are safe placeholders / development defaults only.
#
#   cp .env.example .env
#
# Local development needs NONE of these set — `manage.py` defaults to
# `config.settings.dev`, which runs without any environment variables. The
# variables below matter for PRODUCTION (`config.settings.prod`).

# -----------------------------------------------------------------------------
# Settings module
# -----------------------------------------------------------------------------
# dev  -> config.settings.dev  (DEBUG off, console email, lax host checking)
# prod -> config.settings.prod (secure cookies, HSTS, strict hosts; secrets req.)
DJANGO_SETTINGS_MODULE=config.settings.dev

# -----------------------------------------------------------------------------
# Secret key  (REQUIRED in production)
# -----------------------------------------------------------------------------
# prod.py reads this and fails loudly if it is missing. Generate a fresh, long
# random value — never reuse the dev fallback in production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# Allowed hosts  (REQUIRED in production)
# -----------------------------------------------------------------------------
# Comma-separated list of the exact hostnames this site is served on. Do NOT use
# "*" in production — it disables Django's Host header validation. Example:
#   DJANGO_ALLOWED_HOSTS=skillswap.example.com,www.skillswap.example.com
# (Development uses config.settings.dev, which intentionally allows all hosts so
# the app works behind the environment's port-forwarding — that is dev-only.)
DJANGO_ALLOWED_HOSTS=skillswap.example.com

# -----------------------------------------------------------------------------
# CSRF trusted origins  (production, if behind a TLS-terminating proxy)
# -----------------------------------------------------------------------------
# Comma-separated scheme://host[:port] entries the browser uses to reach the
# site. Needed when a proxy terminates HTTPS so POST forms pass CSRF checks.
#   CSRF_TRUSTED_ORIGINS=https://skillswap.example.com
# CSRF_TRUSTED_ORIGINS=

# -----------------------------------------------------------------------------
# Trusted reverse-proxy count for rate limiting  (optional, default 0)
# -----------------------------------------------------------------------------
# Number of reverse proxies YOU control that sit in front of the app and append
# to X-Forwarded-For. Leave at 0 unless you run such proxies — otherwise a
# client could spoof the header to dodge IP-based rate limits.
# RATELIMIT_TRUSTED_PROXY_COUNT=0

# -----------------------------------------------------------------------------
# Path-prefix proxy support  (optional)
# -----------------------------------------------------------------------------
# Set ONLY when the app is reached through a proxy that strips a sub-path and
# sends no X-Forwarded-Prefix header — e.g. code-server's /proxy/<port>/. Then
# every link/redirect/asset URL is prefixed so navigation stays inside the mount.
# Leave empty for direct access or a code-server /absproxy/<port>/ mount
# (auto-detected). Example:
#   APP_URL_PREFIX=/proxy/8899
APP_URL_PREFIX=

# -----------------------------------------------------------------------------
# Google Calendar / Meet integration  (optional, OFF by default — see R6/R8)
# -----------------------------------------------------------------------------
# Enable only when OAuth credentials and the Google client libraries are present.
# GOOGLE_INTEGRATION_ENABLED=false
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
